    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c33c1427-6955-4bc9-8680-102593e93ce9</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>  
